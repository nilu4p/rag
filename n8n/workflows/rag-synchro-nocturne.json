{
  "id": "ragNightlySync1",
  "name": "RAG – Vérification nocturne de l'index",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "s1",
      "name": "Chaque nuit à 3 h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "s0",
      "name": "Lancer à la main",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "s2",
      "name": "Synchroniser documents/",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_URL }}/api/index",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RAG_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"wait\": true}",
        "options": {
          "timeout": 3600000
        }
      }
    },
    {
      "id": "s3",
      "name": "État du service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.RAG_URL }}/api/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RAG_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Chaque nuit à 3 h": {
      "main": [
        [
          {
            "node": "Synchroniser documents/",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lancer à la main": {
      "main": [
        [
          {
            "node": "Synchroniser documents/",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Synchroniser documents/": {
      "main": [
        [
          {
            "node": "État du service",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}