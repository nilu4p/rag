# Configuration de l'assistant RAG. Créé automatiquement en .env par `make` :
# __SECRET__ / __PASSWORD__ sont remplacés par des valeurs aléatoires. Après modification : make up

# ---- Accès au chat (le navigateur demande ces identifiants) ----
CHAT_USER=moi
CHAT_PASSWORD=__PASSWORD__
# Jeton pour les scripts et n8n (en-tête Authorization: Bearer …)
RAG_API_TOKEN=__SECRET__

# ---- Réseau ----
# 127.0.0.1 = accessible uniquement depuis ce PC ; 0.0.0.0 = aussi depuis le réseau local (téléphone…)
BIND_ADDR=127.0.0.1
RAG_PORT=8000
N8N_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678

# ---- Ollama (installé sur le PC, hors Docker) ----
OLLAMA_URL=http://host.docker.internal:11434
# LLM des réponses. Sur CPU, préfère un modèle MoE (« mixture of experts ») :
#   gpt-oss:20b      généraliste, bon en français, ~14 Go de RAM (défaut)
#   qwen3:30b-a3b    MoE très rapide, ~19 Go
#   qwen3:8b         pour 16 Go de RAM ou moins
CHAT_MODEL=gpt-oss:20b
# Embeddings multilingues (si tu le changes, la base est reconstruite automatiquement)
EMBED_MODEL=bge-m3
# Fenêtre de contexte (tokens) : extraits + pages web doivent y tenir
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m
# Réflexion des modèles qui « pensent » : low (gpt-oss, le plus rapide), medium, high ; off pour qwen3
LLM_THINK=low
LLM_TEMPERATURE=0.2

# ---- Recherche dans les documents ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Nombre d'extraits donnés au LLM
TOP_K=6
# Pertinence minimale d'un extrait (0 à 1) : monte-la si les réponses citent des passages hors sujet
MIN_SCORE=0.40
# Échanges précédents pris en compte (questions de suite : « et là-bas ? »)
MEMORY_TURNS=4
# 1 = le LLM choisit l'outil (documents, internet, conversation) ; 0 = toujours les documents (plus rapide)
QUERY_ROUTER=1
# Fréquence de vérification du dossier documents/ (secondes)
INDEX_INTERVAL=30
# Langues de l'OCR (PDF scannés, photos) : fra, eng installées
OCR_LANGS=fra+eng
MAX_FILE_MB=200

# ---- Internet (SearXNG auto-hébergé, sans compte ni clé) ----
# auto = si tes documents ne suffisent pas ; off = jamais (rien ne sort de ta machine)
WEB_SEARCH=auto
WEB_RESULTS=4
WEB_LANG=fr
SEARXNG_SECRET=__SECRET__

# ---- n8n (automatisations) ----
N8N_OWNER_EMAIL=admin@rag.local
N8N_OWNER_PASSWORD=__PASSWORD__
N8N_ENCRYPTION_KEY=__SECRET__
N8N_JWT_SECRET=__SECRET__

# ---- Divers ----
QDRANT_API_KEY=__SECRET__
QDRANT_COLLECTION=documents
TIMEZONE=America/Cayenne
BACKUP_KEEP_DAYS=7
DNS_1=1.1.1.1
DNS_2=9.9.9.9
# Utilisateur du PC (droits sur documents/)
HOST_UID=__UID__
HOST_GID=__GID__

# ---- Versions des images ----
N8N_VERSION=2.45.7
QDRANT_VERSION=v1.13.4
SEARXNG_VERSION=latest
